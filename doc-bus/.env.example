# Example settings for doc-bus.
# Copy to .env and adjust:  cp -n .env.example .env
# Real environment variables take precedence over values in .env.

# --- Azure Service Bus: outputs of resource_servicebus.bicep ---
# az deployment group show -g rg-doc-bus -n resource_servicebus --query properties.outputs

# SERVICEBUS_FULLY_QUALIFIED_NAMESPACE output
SERVICEBUS_FULLY_QUALIFIED_NAMESPACE=jimsbus20261012ai200.servicebus.windows.net

# SERVICEBUS_QUEUE_NAME output (default: summarize-jobs)
SERVICEBUS_QUEUE_NAME=summarize-jobs
