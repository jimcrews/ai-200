# Example settings for fastapi-factory.
# Copy to .env and adjust:  cp .env.example .env
# Every variable is optional; the defaults are in src/fastapi_factory/config.py.
# Real environment variables take precedence over values in .env.

# Display name, used as the OpenAPI title (default: FastAPI Factory)
APP_APP_NAME="FastAPI Factory"

# Environment name, reported by /health (default: local)
APP_ENVIRONMENT=local

# Log level for the app's own loggers: DEBUG, INFO, WARNING, ERROR or CRITICAL (default: INFO)
APP_LOG_LEVEL=INFO

# --- Server options: used only by `uv run fastapi-factory`, not by the Docker image ---

# Interface to bind to; use 0.0.0.0 to accept connections from other machines (default: 127.0.0.1)
APP_HOST=127.0.0.1

# Port to listen on (default: 8000)
APP_PORT=8000

# Restart automatically when code changes; local development only (default: false)
APP_RELOAD=true
