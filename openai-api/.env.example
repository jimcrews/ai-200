# Example settings for openai-api.
# Copy to .env and adjust:  cp .env.example .env

APP_AZURE_OPENAI_ENDPOINT=
APP_AZURE_OPENAI_API_KEY=
APP_LLM_MODEL_DEPLOYMENT_NAME=
APP_LLM_MAX_TOKENS=150
APP_LLM_TEMPERATURE=0.7
APP_LLM_TOP_P=0.9

# Display name, used as the OpenAPI title (default: OpenAI API)
APP_APP_NAME="OpenAI API"

# Environment name, reported by /health (default: local)
APP_ENVIRONMENT=local

# Log level for the app's own loggers: DEBUG, INFO, WARNING, ERROR or CRITICAL (default: INFO)
APP_LOG_LEVEL=INFO

# --- Server options: used only by `uv run openai-api`, not by the Docker image ---

# Interface to bind to; use 0.0.0.0 to accept connections from other machines (default: 127.0.0.1)
APP_HOST=127.0.0.1

# Port to listen on (default: 8000)
APP_PORT=8000

# Restart automatically when code changes; local development only (default: false)
APP_RELOAD=true
