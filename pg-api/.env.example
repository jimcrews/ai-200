# Example settings for pg-api.
# Copy to .env and adjust:  cp -n .env.example .env
# Every variable is optional; the defaults are in src/pg_api/config.py.
# Real environment variables take precedence over values in .env.

# Display name, used as the OpenAPI title (default: PG API)
APP_APP_NAME="PG API"

# Environment name, reported by /health (default: local)
APP_ENVIRONMENT=local

# Log level for the app's own loggers: DEBUG, INFO, WARNING, ERROR or CRITICAL (default: INFO)
APP_LOG_LEVEL=INFO

# --- Server options: used only by `uv run pg-api`, not by the Docker image ---

# Interface to bind to; use 0.0.0.0 to accept connections from other machines (default: 127.0.0.1)
APP_HOST=127.0.0.1

# Port to listen on (default: 8000)
APP_PORT=8000

# Restart automatically when code changes; local development only (default: false)
APP_RELOAD=true

# --- Azure OpenAI (Foundry): outputs of deploy_foundry.bicep ---

APP_AZURE_OPENAI_ENDPOINT=https://jimfoundryai200.services.ai.azure.com/openai/v1

# az cognitiveservices account keys list --name jimfoundryai200 --resource-group rg-pg-api --query key1 -o tsv
APP_AZURE_OPENAI_API_KEY=

APP_LLM_MODEL_DEPLOYMENT_NAME=jimfoundryai200-llm-deploy
APP_LLM_MAX_TOKENS=300
APP_LLM_TEMPERATURE=0.2
APP_LLM_TOP_P=0.9

APP_EMBEDDING_MODEL_DEPLOYMENT_NAME=jimfoundryai200-emb-deploy

# --- Postgres DB: outputs of deploy_postgres.bicep ---
APP_POSTGRES_HOST=
APP_POSTGRES_DB=
APP_POSTGRES_USER=
APP_POSTGRES_PASSWORD=


# --- Vector search ---

# Number of results to return (default: 5)
APP_VECTOR_SEARCH_TOP_K=5
# Minimum cosine similarity (0-1); leave commented out for no filtering (default: none).
# text-embedding-3-small scores are typically 0.3-0.6 for relevant matches.
APP_VECTOR_SEARCH_SIMILARITY_THRESHOLD=0.35
